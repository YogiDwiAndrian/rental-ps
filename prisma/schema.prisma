// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  super_admin
  owner
  staff
}

enum UnitStatus {
  available
  occupied
  maintenance
  broken
}

enum BillingType {
  timer
  hourly
  package
  hybrid
}

enum SessionStatus {
  active
  completed
  cancelled
  power_outage_stopped
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum TransactionType {
  rental
  fnb
  extension
  refund
}

// ============================================
// NEXTAUTH MODELS (Required for Authentication)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ============================================
// CORE BUSINESS MODELS
// ============================================

model Tenant {
  id                    String    @id @default(cuid())
  name                  String
  subdomain             String    @unique
  customDomain          String?   @unique @map("custom_domain")
  domainVerified        Boolean   @default(false) @map("domain_verified")
  customerPageEnabled   Boolean   @default(true) @map("customer_page_enabled")
  ownerId               String?   @map("owner_id")
  address               String?
  phone                 String?
  settings              Json      @default("{}")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  users                 User[]
  locations             Location[]
  fnbCategories         FnbCategory[]
  fnbItems              FnbItem[]
  fnbOrders             FnbOrder[]
  rentalSessions        RentalSession[]
  transactions          Transaction[]
  customerPageConfig    CustomerPageConfig[]
  
  @@map("tenants")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime? @map("email_verified")
  name                  String?
  image                 String?
  passwordHash          String?   @map("password_hash")
  role                  UserRole  @default(staff)
  tenantId              String?   @map("tenant_id")
  firstName             String?   @map("first_name")
  lastName              String?   @map("last_name")
  phone                 String?
  isActive              Boolean   @default(true) @map("is_active")
  lastLoginAt           DateTime? @map("last_login_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationAssignments   UserLocationAssignment[]
  rentalSessions        RentalSession[]
  transactions          Transaction[]
  sessionExtensions     SessionExtension[]
  powerOutageEvents     PowerOutageEvent[]
  
  // NextAuth relations
  accounts              Account[]
  sessions              Session[]
  
  @@map("users")
}

model Location {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  name                  String
  code                  String
  address               String
  phone                 String?
  email                 String?
  managerId             String?   @map("manager_id")
  publicDescription     String?   @map("public_description")
  operationalHours      Json      @default("{}") @map("operational_hours")
  settings              Json      @default("{}")
  showOnCustomerPage    Boolean   @default(true) @map("show_on_customer_page")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAssignments       UserLocationAssignment[]
  units                 Unit[]
  rentalSessions        RentalSession[]
  fnbCategories         FnbCategory[]
  fnbItems              FnbItem[]
  fnbOrders             FnbOrder[]
  transactions          Transaction[]
  powerOutageEvents     PowerOutageEvent[]
  customerPageConfig    CustomerPageConfig[]
  
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("locations")
}

model UserLocationAssignment {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  locationId            String    @map("location_id")
  assignedBy            String    @map("assigned_by")
  assignedAt            DateTime  @default(now()) @map("assigned_at")
  isActive              Boolean   @default(true) @map("is_active")

  // Relations
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location              Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  @@unique([userId, locationId])
  @@map("user_location_assignments")
}

model Unit {
  id                    String      @id @default(cuid())
  tenantId              String      @map("tenant_id")
  locationId            String      @map("location_id")
  name                  String
  consoleType           String      @map("console_type")
  controllerCount       Int         @default(1) @map("controller_count")
  status                UnitStatus  @default(available)
  hourlyRate            Decimal     @map("hourly_rate") @db.Decimal(8,2)
  packageRates          Json        @default("{}") @map("package_rates")
  specifications        Json        @default("{}")
  showOnCustomerPage    Boolean     @default(true) @map("show_on_customer_page")
  customerDisplayName   String?     @map("customer_display_name")
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  // Relations
  location              Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  rentalSessions        RentalSession[]
  
  @@unique([locationId, name])
  @@map("units")
}

// ============================================
// RENTAL SYSTEM MODELS
// ============================================

model RentalSession {
  id                    String        @id @default(cuid())
  tenantId              String        @map("tenant_id")
  locationId            String        @map("location_id")
  unitId                String        @map("unit_id")
  staffId               String        @map("staff_id")
  billingModel          BillingType   @map("billing_model")
  startTime             DateTime      @map("start_time")
  endTime               DateTime?     @map("end_time")
  purchasedDuration     Int?          @map("purchased_duration") // minutes
  extendedDuration      Int           @default(0) @map("extended_duration")
  sessionIdentifier     String?       @map("session_identifier")
  totalAmount           Decimal?      @map("total_amount") @db.Decimal(10,2)
  psAmount              Decimal?      @map("ps_amount") @db.Decimal(10,2)
  fnbAmount             Decimal       @default(0) @map("fnb_amount") @db.Decimal(10,2)
  status                SessionStatus @default(active)
  paymentStatus         PaymentStatus @default(pending) @map("payment_status")
  paymentMethod         String        @default("cash") @map("payment_method")
  powerOutageEventId    String?       @map("power_outage_event_id")
  emergencyStopReason   String?       @map("emergency_stop_reason")
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location              Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  unit                  Unit          @relation(fields: [unitId], references: [id])
  staff                 User          @relation(fields: [staffId], references: [id])
  powerOutageEvent      PowerOutageEvent? @relation(fields: [powerOutageEventId], references: [id])
  sessionExtensions     SessionExtension[]
  fnbOrders             FnbOrder[]
  transactions          Transaction[]
  
  @@map("rental_sessions")
}

model SessionExtension {
  id                    String        @id @default(cuid())
  sessionId             String        @map("session_id")
  extendedDuration      Int           @map("extended_duration") // minutes
  additionalAmount      Decimal       @map("additional_amount") @db.Decimal(10,2)
  originalBillingModel  BillingType?  @map("original_billing_model")
  extensionType         String?       @map("extension_type")
  paymentStatus         PaymentStatus @default(pending) @map("payment_status")
  extendedBy            String        @map("extended_by")
  createdAt             DateTime      @default(now()) @map("created_at")

  // Relations
  session               RentalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  extendedByUser        User          @relation(fields: [extendedBy], references: [id])
  
  @@map("session_extensions")
}

model PowerOutageEvent {
  id                    String    @id @default(cuid())
  locationId            String    @map("location_id")
  triggeredBy           String    @map("triggered_by")
  triggeredAt           DateTime  @map("triggered_at")
  affectedSessions      Int       @map("affected_sessions")
  totalRevenueSecured   Decimal   @map("total_revenue_secured") @db.Decimal(10,2)
  recoveryTime          DateTime? @map("recovery_time")
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")

  // Relations
  location              Location  @relation(fields: [locationId], references: [id])
  triggeredByUser       User      @relation(fields: [triggeredBy], references: [id])
  affectedRentalSessions RentalSession[]
  
  @@map("power_outage_events")
}

// ============================================
// F&B SYSTEM MODELS
// ============================================

model FnbCategory {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  locationId            String?   @map("location_id")
  name                  String
  description           String?
  displayOrder          Int       @default(0) @map("display_order")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location              Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fnbItems              FnbItem[]
  
  @@map("fnb_categories")
}

model FnbItem {
  id                    String      @id @default(cuid())
  tenantId              String      @map("tenant_id")
  locationId            String?     @map("location_id")
  categoryId            String?     @map("category_id")
  name                  String
  description           String?
  sellingPrice          Decimal     @map("selling_price") @db.Decimal(10,2)
  costPrice             Decimal?    @map("cost_price") @db.Decimal(10,2)
  stockQuantity         Int         @default(0) @map("stock_quantity")
  minStockAlert         Int         @default(5) @map("min_stock_alert")
  unitType              String      @default("pcs") @map("unit_type")
  showOnCustomerPage    Boolean     @default(true) @map("show_on_customer_page")
  customerDisplayName   String?     @map("customer_display_name")
  customerDescription   String?     @map("customer_description")
  displayOrder          Int         @default(0) @map("display_order")
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location              Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category              FnbCategory? @relation(fields: [categoryId], references: [id])
  fnbOrders             FnbOrder[]
  
  @@unique([locationId, name])
  @@map("fnb_items")
}

model FnbOrder {
  id                    String        @id @default(cuid())
  tenantId              String        @map("tenant_id")
  locationId            String        @map("location_id")
  rentalSessionId       String?       @map("rental_session_id")
  fnbItemId             String        @map("fnb_item_id")
  quantity              Int
  unitPrice             Decimal       @map("unit_price") @db.Decimal(10,2)
  totalAmount           Decimal       @map("total_amount") @db.Decimal(10,2)
  paymentTiming         String        @default("end_of_session") @map("payment_timing")
  paymentStatus         PaymentStatus @default(pending) @map("payment_status")
  orderNotes            String?       @map("order_notes")
  servedAt              DateTime?     @map("served_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location              Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  rentalSession         RentalSession? @relation(fields: [rentalSessionId], references: [id])
  fnbItem               FnbItem       @relation(fields: [fnbItemId], references: [id])
  
  @@map("fnb_orders")
}

// ============================================
// FINANCIAL MODELS
// ============================================

model Transaction {
  id                    String          @id @default(cuid())
  tenantId              String          @map("tenant_id")
  locationId            String          @map("location_id")
  sessionId             String?         @map("session_id")
  staffId               String          @map("staff_id")
  type                  TransactionType
  totalAmount           Decimal         @map("total_amount") @db.Decimal(10,2)
  psAmount              Decimal         @default(0) @map("ps_amount") @db.Decimal(10,2)
  fnbAmount             Decimal         @default(0) @map("fnb_amount") @db.Decimal(10,2)
  paymentMethod         String          @default("cash") @map("payment_method")
  paymentStatus         PaymentStatus   @default(pending) @map("payment_status")
  receiptNumber         String?         @map("receipt_number")
  receiptData           Json?           @map("receipt_data")
  notes                 String?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location              Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  session               RentalSession?  @relation(fields: [sessionId], references: [id])
  staff                 User            @relation(fields: [staffId], references: [id])
  
  @@map("transactions")
}

// ============================================
// CONFIGURATION MODELS
// ============================================

model CustomerPageConfig {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  locationId            String?   @map("location_id")
  showUnitStatus        Boolean   @default(true) @map("show_unit_status")
  showRemainingTime     Boolean   @default(true) @map("show_remaining_time")
  showPricing           Boolean   @default(true) @map("show_pricing")
  showFnbMenu           Boolean   @default(true) @map("show_fnb_menu")
  showContactInfo       Boolean   @default(true) @map("show_contact_info")
  unitStatusRefreshSeconds Int    @default(30) @map("unit_status_refresh_seconds")
  fnbMenuRefreshSeconds Int       @default(300) @map("fnb_menu_refresh_seconds")
  primaryColor          String    @default("#3B82F6") @map("primary_color")
  publicPhone           String?   @map("public_phone")
  publicEmail           String?   @map("public_email")
  publicAddress         String?   @map("public_address")
  whatsappNumber        String?   @map("whatsapp_number")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location              Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, locationId])
  @@map("customer_page_config")
}

model LandingPageConfig {
  id                    String    @id @default(cuid())
  companyName           String    @default("RentalPS Platform") @map("company_name")
  companyDescription    String?   @map("company_description")
  starterPrice          Int       @default(150000) @map("starter_price")
  starterFeatures       Json      @default("[]") @map("starter_features")
  premiumPrice          Int       @default(250000) @map("premium_price")
  premiumFeatures       Json      @default("[]") @map("premium_features")
  enterprisePrice       Int       @default(500000) @map("enterprise_price")
  enterpriseFeatures    Json      @default("[]") @map("enterprise_features")
  contactPhone          String?   @map("contact_phone")
  contactEmail          String?   @map("contact_email")
  contactWhatsapp       String?   @map("contact_whatsapp")
  featuresList          Json      @default("[]") @map("features_list")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  
  @@map("landing_page_config")
}